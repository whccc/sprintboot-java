<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.practica</groupId>
	<artifactId>crudpruebas</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Actuator: expone endpoints tipo /actuator/health, /actuator/info,
		     /actuator/metrics: pensados para que un load balancer, un
		     Kubernetes liveness probe, o un dashboard de monitoreo consulten
		     el estado de la app sin tener que inventar un endpoint propio
		     para eso. Que endpoints quedan expuestos por HTTP se controla
		     en application.yaml (management.endpoints.web.exposure.include):
		     por default Spring SOLO expone health e info, a proposito: el
		     resto (env, beans, heapdump...) puede filtrar informacion
		     sensible si se expone sin pensar. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- OpenAPI/Swagger: escanea los @RestController y genera el spec
		     automaticamente (no es springfox: ese ya no se mantiene, este
		     es el estandar actual). Con "-ui" incluido, tambien sirve la
		     interfaz visual en /swagger-ui.html: sin eso, solo tendrias
		     el JSON crudo en /v3/api-docs. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.8.5</version>
		</dependency>

		<!-- JJWT: generar y validar tokens JWT. No lo trae Spring Security
		     por si solo: Spring Security valida CUALQUIER esquema de auth,
		     JWT es una eleccion nuestra, no un default. -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Solo para tener WebClient disponible (cliente HTTP reactivo).
		     NO convierte el server en reactivo: seguimos con Tomcat/MVC,
		     esto es una herramienta que se usa puntualmente donde hace falta. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>

		<!-- Driver JDBC oficial de Oracle (Maven Central lo distribuye libre,
		     sin necesitar cuenta de Oracle para descargarlo). -->
		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>ojdbc11</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>

		<!-- Igual que nos paso con H2: el soporte de cada motor es un modulo
		     aparte de flyway-core. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-oracle</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Modulos separados (en versiones previas de Spring Boot venian
		     incluidos dentro de starter-test) para los test "slice":
		     @DataJpaTest y @WebMvcTest -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Trae @AutoConfigureTestDatabase: lo necesitamos para decirle a
		     @DataJpaTest que NO reemplace el datasource por uno embebido
		     (ya no hay H2 en el classpath; ahora es Oracle real tambien en tests). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-jdbc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- @WithMockUser y los request post-processors (with(csrf()), etc.)
		     para simular usuarios autenticados en los tests @WebMvcTest. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<!-- Sin esto, /actuator/info devuelve un objeto vacio {}.
					     Este goal genera target/classes/META-INF/build-info.properties
					     en cada build (nombre, version, momento del build): el
					     endpoint "info" simplemente lee ese archivo, no hace nada
					     "magico" en runtime. -->
					<execution>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
