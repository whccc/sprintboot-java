# PLANTILLA -- este archivo SI se sube a git (mismo criterio que
# application-local.yaml.example). Copialo como ".env" (sin ".example")
# en la raiz del proyecto, completa valores reales, y docker-compose lo
# lee automaticamente -- no hace falta exportar nada a mano.

# Clave del usuario SYS/administrador de Oracle dentro del contenedor.
# Solo se usa para inicializar la instancia -- la app nunca se conecta
# con este usuario.
ORACLE_SYS_PASSWORD=cambiar-esta-clave-admin

# Mismo usuario/clave que la app espera en application.yaml
# (ORACLE_DB_PASSWORD) -- el contenedor de Oracle crea este usuario
# automaticamente al arrancar, con esta misma clave.
ORACLE_DB_PASSWORD=cambiar-esta-clave-app

# Igual que en application.yaml: minimo 32 caracteres para HS256.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-random-de-verdad-1234

CLIMA_API_KEY=sin-configurar
